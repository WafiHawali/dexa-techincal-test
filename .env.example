# Copy to .env and replace every CHANGE_ME value. URL-encode credentials in DATABASE_URL.
DATABASE_URL=mysql://dexa:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/dexa
MYSQL_DATABASE=dexa
MYSQL_USER=dexa
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
PORT=3000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
AUTH_HOST=127.0.0.1
AUTH_PORT=4001
EMPLOYEE_HOST=127.0.0.1
EMPLOYEE_PORT=4002
ATTENDANCE_HOST=127.0.0.1
ATTENDANCE_PORT=4003
FILE_HOST=127.0.0.1
FILE_PORT=4004
UPLOAD_DIR=./uploads
# Required only when explicitly running db:seed or the Compose seed profile.
SEED_HRD_EMAIL=
SEED_HRD_PASSWORD=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
